{
  "name": "everybox",
  "version": "1.0.0",
  "description": "EveryBox for Windows — every inbox and calendar in one calm place, with private local AI",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "mcp": "node ./out/mcp/server.js",
    "package": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "googleapis": "^190.0.0",
    "ical.js": "^2.1.0",
    "imapflow": "^1.0.172",
    "lucide-react": "^0.475.0",
    "mailparser": "^3.7.2",
    "marked": "^15.0.7",
    "nodemailer": "^10.1.4",
    "tsdav": "^2.1.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.10",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^42.11.16",
    "electron-builder": "^26.18.0",
    "electron-vite": "^3.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.1.1"
  },
  "build": {
    "appId": "app.everybox.desktop",
    "productName": "EveryBox",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "electron@35.7.5": true,
    "esbuild@0.25.12": true
  }
}
